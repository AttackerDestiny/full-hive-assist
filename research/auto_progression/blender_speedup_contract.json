{
  "source": "ReplicatedStorage.Gui.BlenderGui.UpdateProgressInfo and SpeedUpOrder",
  "elapsedSeconds": "PlaytimeAtLoad + OfflineProgressTime + OsTime() - LoadTime - BlenderState.StartTime",
  "totalSeconds": "BlenderState.Count * BlenderRecipes.Get(Recipe).Time",
  "completedUnits": "floor(clamp(elapsed/total,0,1) * Count)",
  "tickets": "ceil((Count - floor(completedUnits)/AutoCompletePerTicket) / AutoCompletePerTicket)",
  "speedupRemote": "Events.ClientCall(BlenderCommand, SpeedUpOrder)",
  "policy": "Do not speed up or spend tickets; this project waits for natural completion.",
  "verifiedRecipeAutoCompletePerTicket": {
    "Gumdrops": 10,
    "MoonCharm": 10,
    "all other inspected recipes": 1
  },
  "statusFields": ["Recipe", "Count", "ElapsedSeconds", "TotalSeconds", "RemainingSeconds", "CompletedUnits", "AutoCompletePerTicket", "SpeedupTickets (read-only)"],
  "receipt": "Only StopOrder after elapsed >= total; then require BlenderState absent and exact output inventory delta Count."
}
